<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16161E"
    android:keepScreenOn="true">

    <!-- Full-screen Digitizer Surface -->
    <com.antigravity.btbridge.DigitizerView
        android:id="@+id/digitizer_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Toolbar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#DD1F2335"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_digitizer_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#24283B"
            android:text="← Exit"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_digitizer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Lapdroid Graphics Tablet"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_aspect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#24283B"
            android:text="16:9 PC Fit"
            android:textColor="#7AA2F7"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_connection_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1A1B26"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Connected"
            android:textColor="#9ECE6A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Telemetry HUD Overlay -->
    <LinearLayout
        android:id="@+id/layout_bottom_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#B016161E"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_telemetry_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Windows Ink PT_PEN Active • Pressure works in OneNote, Whiteboard, Krita, Photoshop"
            android:textColor="#7A88CF"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
